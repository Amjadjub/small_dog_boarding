DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://dog_boarding:local_dev_only@localhost:5432/dog_boarding
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@small-dog-boarding.local
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_VERIFICATION_TIMEOUT=86400
PASSWORD_RESET_TIMEOUT=3600
CACHE_BACKEND=django.core.cache.backends.locmem.LocMemCache
CACHE_LOCATION=small-dog-boarding

ADMIN_1_USERNAME=manager_one
ADMIN_1_EMAIL=manager1@example.invalid
ADMIN_1_PASSWORD=replace-with-a-strong-unique-password
ADMIN_2_USERNAME=manager_two
ADMIN_2_EMAIL=manager2@example.invalid
ADMIN_2_PASSWORD=replace-with-another-strong-unique-password
